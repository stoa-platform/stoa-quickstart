# STOA Stripe Proxy — Environment Variables
# Copy to .env and fill in your values

# STOA quickstart URL (default: local quickstart)
STOA_URL=http://localhost:8080

# STOA admin credentials
STOA_ADMIN_USER=admin
STOA_ADMIN_PASS=admin

# Upstream: use mock for local dev, real Stripe for production
# Mock (default, included in docker-compose.yml):
STRIPE_UPSTREAM_URL=http://stripe-mock:12111
# Real Stripe (replace with your key):
# STRIPE_UPSTREAM_URL=https://api.stripe.com
# STRIPE_API_KEY=sk_test_your_key_here
