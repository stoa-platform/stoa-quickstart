# STOA Notion MCP Bridge — Environment Variables

STOA_URL=http://localhost:8080
STOA_ADMIN_USER=admin
STOA_ADMIN_PASS=admin

# Notion integration token (https://www.notion.so/my-integrations)
# Use "secret_mock_token" for offline testing with mock server
NOTION_TOKEN=secret_your_token_here

# Upstream: mock (default) or real Notion API
NOTION_UPSTREAM=http://notion-mock:1080
# NOTION_UPSTREAM=https://api.notion.com
